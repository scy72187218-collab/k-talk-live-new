{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ktalk26",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ktalk26/",
      "destination": "/ktalk26",
      "permanent": false
    }
  ]
}
